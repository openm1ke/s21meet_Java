<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="PMD main ruleset"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">

    <description>
        PMD rules for main sources: keep error-prone checks, but allow defensive catch blocks at integration boundaries.
    </description>

    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidCatchingGenericException" />
    </rule>
</ruleset>
